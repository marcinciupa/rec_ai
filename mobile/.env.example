# Skopiuj do .env. EXPO_PUBLIC_* jest wstrzykiwane do bundla klienta.

# URL backendu REC_AI. DEV: URL tunelu cloudflared (publiczny adres lokalnego backendu).
# PROD: staly URL backendu na Railway. Po zmianie zrestartuj `expo start`.
EXPO_PUBLIC_API_URL=https://twoj-backend.example.com

# Sekret app<->backend, wysylany jako naglowek X-App-Key. TEN SAM string co APP_API_KEY na Railway
# (railway variables --service rec-ai-backend). Backend jest fail-closed: BEZ tego /transcriptions
# i /chat zwracaja 401, wiec build sklepowy bez tej zmiennej ma MARTWE funkcje AI.
# EXPO_PUBLIC_* laduje w bundlu i da sie go wydobyc z APK - to bariera anty-scraping przed otwartym
# proxy do platnych kluczy, NIE autoryzacja uzytkownika. Rotacja = zmiana w Railway + nowy build.
EXPO_PUBLIC_APP_KEY=
